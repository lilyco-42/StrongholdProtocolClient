# --- dependencies & build output ----------------------------------------------------------------------------
node_modules/
build/

# Tauri：cargo 的输出、以及 CI 在打包前解进来的那份 payload（与 desktop/ 用的同一个 www，不进 git）。
tauri/src-tauri/target/
tauri/src-tauri/www/
# tauri-build 每次编译现生成的 schema / ACL 清单，不进 git（`dist/index.html` 那个占位页是**跟踪**的）。
tauri/src-tauri/gen/
# 联机 sidecar（tools/fetch-lan-core.mjs 下载的上游 EasyTier 二进制 + 含密钥的 lan-config.json）。
# 24 MB 的二进制不进 git，密钥更不能 —— CI 从 secrets 生成。
tauri/src-tauri/lan/
tauri/src-tauri/icons/*.png

# Capacitor copies the assembled payload into the Android project (generated by `cap sync`); mobile/android/.gitignore
# already covers these, this is belt and braces.
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/app/src/main/assets/public/
mobile/android/app/src/main/assets/capacitor.config.json

# --- local toolchain / OS clutter ---------------------------------------------------------------------------
.tools/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
