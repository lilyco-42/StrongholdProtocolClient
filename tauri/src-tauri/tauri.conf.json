{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StrongholdProtocolTauri",
  "version": "0.2.2",
  "identifier": "top.lain42.strongholdprotocol.tauri",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Game",
    "icon": ["icons/icon.ico"],
    "resources": ["www"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
